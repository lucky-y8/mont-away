# Frontend configuration / 前端配置
VITE_API_URL=http://127.0.0.1:8000

# AMap Web JS API; use a service proxy in production. / 高德 Web JS API；生产环境请使用安全代理。
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_JS_CODE=
VITE_AMAP_SERVICE_HOST=

# Backend runtime and database / 后端运行环境与数据库
ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./shanyao.db
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
EXPOSE_DEBUG_TOKENS=true

# Email delivery; password means the SMTP authorization code. / 邮件发送；密码字段填写 SMTP 授权码。
EMAIL_NOTIFICATIONS=true
EMAIL_BACKEND=smtp
EMAIL_DRY_RUN=true
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=your-address@example.com
SMTP_PASSWORD=
SMTP_FROM=your-address@example.com
SMTP_STARTTLS=false
SMTP_SSL=true

# Initial administrator and confirmed post reward. / 初始管理员与已确认的发帖奖励。
INITIAL_ADMIN_EMAIL=
POST_REWARD_POINTS=5

# Local media is for development only. / 本地媒体存储仅用于开发环境。
MEDIA_BACKEND=local
MEDIA_LOCAL_DIR=uploads
MEDIA_PUBLIC_URL=http://127.0.0.1:8000/media
MAX_UPLOAD_BYTES=52428800

# WeChat website OAuth; blank values keep the endpoint disabled. / 微信网站 OAuth；留空时接口保持禁用。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/wechat/callback
