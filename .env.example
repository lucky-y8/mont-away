# Frontend configuration; Vite requires the VITE_ prefix. / 前端配置；Vite 强制要求 VITE_ 前缀。
VITE_SHANYAO_API_URL=http://127.0.0.1:8000
VITE_SHANYAO_SITE_URL=https://sy.chexi.tech

# AMap Web JS API; use a service proxy in production. / 高德 Web JS API；生产环境请使用安全代理。
VITE_SHANYAO_AMAP_KEY=
VITE_SHANYAO_AMAP_SECURITY_JS_CODE=
VITE_SHANYAO_AMAP_SERVICE_HOST=

# Backend runtime and native PostgreSQL service / 后端运行环境与 PostgreSQL 原生系统服务
SHANYAO_APP_NAME=Shanyao API
SHANYAO_ENVIRONMENT=local
SHANYAO_API_PREFIX=/api/v1
SHANYAO_POSTGRES_HOST=127.0.0.1
SHANYAO_POSTGRES_PORT=5432
SHANYAO_POSTGRES_DB=shanyao_prod
SHANYAO_POSTGRES_USER=shanyao_app
SHANYAO_POSTGRES_PASSWORD=replace-before-first-start
SHANYAO_DATABASE_URL=postgresql+asyncpg://shanyao_app:replace-before-first-start@127.0.0.1:5432/shanyao_prod
SHANYAO_JWT_SECRET=replace-with-at-least-32-random-characters
SHANYAO_ACCESS_TOKEN_MINUTES=15
SHANYAO_REFRESH_TOKEN_DAYS=30
SHANYAO_VERIFICATION_TOKEN_MINUTES=30
SHANYAO_PASSWORD_RESET_TOKEN_MINUTES=30
SHANYAO_OAUTH_CODE_MINUTES=5
SHANYAO_FRONTEND_URL=http://127.0.0.1:5173
SHANYAO_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SHANYAO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
SHANYAO_EXPOSE_DEBUG_TOKENS=true

# Email delivery; password means the SMTP authorization code. / 邮件发送；密码字段填写 SMTP 授权码。
SHANYAO_EMAIL_NOTIFICATIONS=true
SHANYAO_EMAIL_BACKEND=smtp
SHANYAO_EMAIL_DRY_RUN=true
SHANYAO_SMTP_HOST=smtp.qq.com
SHANYAO_SMTP_PORT=465
SHANYAO_SMTP_USERNAME=your-address@example.com
SHANYAO_SMTP_PASSWORD=
SHANYAO_SMTP_FROM=your-address@example.com
SHANYAO_SMTP_STARTTLS=false
SHANYAO_SMTP_SSL=true

# Initial administrator and confirmed post reward. / 初始管理员与已确认的发帖奖励。
SHANYAO_INITIAL_ADMIN_EMAIL=
SHANYAO_POST_REWARD_POINTS=5

# Local media is for development only. / 本地媒体存储仅用于开发环境。
SHANYAO_MEDIA_BACKEND=local
SHANYAO_MEDIA_LOCAL_DIR=uploads
SHANYAO_MEDIA_PUBLIC_URL=http://127.0.0.1:8000/media
SHANYAO_MAX_UPLOAD_BYTES=52428800

# WeChat website OAuth; blank values keep the endpoint disabled. / 微信网站 OAuth；留空时接口保持禁用。
SHANYAO_WECHAT_APP_ID=
SHANYAO_WECHAT_APP_SECRET=
SHANYAO_WECHAT_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/wechat/callback
