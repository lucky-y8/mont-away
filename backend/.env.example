ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./shanyao.db
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
EXPOSE_DEBUG_TOKENS=true
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
INITIAL_ADMIN_EMAIL=
# 奖励金额确认后再填写；留空时审核通过但积分保持待配置。
POST_REWARD_POINTS=
MEDIA_BACKEND=local
MEDIA_LOCAL_DIR=uploads
MEDIA_PUBLIC_URL=http://127.0.0.1:8000/media
MAX_UPLOAD_BYTES=52428800

# 微信开放平台网站应用配置；未配置时微信登录接口返回 503。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/wechat/callback
