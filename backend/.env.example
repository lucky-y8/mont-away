ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./shanyao.db
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://127.0.0.1:5173
EXPOSE_DEBUG_TOKENS=true

# 微信开放平台网站应用配置；未配置时微信登录接口返回 503。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/wechat/callback
